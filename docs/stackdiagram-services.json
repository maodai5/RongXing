{
  "title": "绒星 2.0 (Fuzzstar) — 猫主人健康管理与陪伴 App 架构",
  "view": "services",
  "nodes": [
    {
      "id": "fastapi",
      "type": "api",
      "label": "绒星 API",
      "tech": "FastAPI + Python 3.11",
      "note": "14 个 router 统一前缀 /api/v1，鉴权分公开 / current_user / consented_user / owned_pet 四档"
    },
    {
      "id": "auth",
      "type": "service",
      "label": "认证与配额",
      "tech": "routers/auth + routers/quota",
      "note": "配额按 UTC 自然日：初筛 10 / 分身 3 / 聊天 50，红线判定豁免配额"
    },
    {
      "id": "pet_domain",
      "type": "service",
      "label": "宠物档案与数字分身",
      "tech": "routers/pets + avatars + avatar_assets",
      "note": "建档、形象三级回退（个人片→占位片→静态）、素材与版本映射"
    },
    {
      "id": "health_domain",
      "type": "service",
      "label": "健康管理",
      "tech": "routers/screening + health + diet + weights",
      "note": "初筛提交、健康分展示、饮食与体重记录"
    },
    {
      "id": "chat_domain",
      "type": "service",
      "label": "聊天与叫声解读",
      "tech": "routers/chat",
      "note": "陪伴对话与叫声情绪解读，置信度 <0.4 标注「不太确定」，仅娱乐参考"
    },
    {
      "id": "motion_domain",
      "type": "service",
      "label": "萌宠动图",
      "tech": "routers/motion + tasks + media",
      "note": "12 个动作的 GIF 生成与播放，客户端只轮询任务状态"
    },
    {
      "id": "triage",
      "type": "function",
      "label": "规则初筛引擎",
      "tech": "services/triage.py + rules/*.yaml",
      "note": "红线最先硬判 urgent → 基础项 vet → 症状最高档 → normal，纯函数可复现，命中即「建议立即就医」卡，绝不经过 LLM"
    },
    {
      "id": "health_score",
      "type": "function",
      "label": "健康分计算",
      "tech": "services/health.py",
      "note": "读时衰减模型，observe 观察窗口 72 小时"
    },
    {
      "id": "advice",
      "type": "function",
      "label": "AI 建议生成",
      "tech": "services/advice.py",
      "note": "只处理非红线部分，消耗分身与聊天配额"
    },
    {
      "id": "tasks_svc",
      "type": "service",
      "label": "任务编排",
      "tech": "services/tasks.py",
      "note": "幂等入队，租约 15 分钟，最多重试 3 次"
    },
    {
      "id": "worker",
      "type": "service",
      "label": "arq Worker",
      "tech": "app/worker.py",
      "note": "max_jobs=2，每 5 秒 sweep 一次租约过期任务；启动强依赖 DASHSCOPE_API_KEY 与 S3 配置"
    },
    {
      "id": "mail_worker",
      "type": "service",
      "label": "邮件 Worker",
      "tech": "services/mail_worker",
      "note": "独立进程发送验证码与提醒邮件，避免阻塞 API 请求"
    },
    {
      "id": "app_native",
      "type": "client",
      "label": "Expo 移动端 (iOS/Android)",
      "tech": "Expo SDK 58 / RN 0.88 / expo-router",
      "note": "原生与 Web 同一套代码，四个 tab 加子页；主题品牌色 #FEAE36"
    },
    {
      "id": "app_web",
      "type": "client",
      "label": "Expo Web 版",
      "tech": "react-native-web 0.21",
      "note": "刷新会丢登录态与离线队列，无录音、无本地通知，生产必须 HTTPS"
    },
    {
      "id": "offline_queue",
      "type": "service",
      "label": "离线队列",
      "tech": "retry-queue / offline-store / offline-sync",
      "note": "diet 与 chat_text 入队，音频不入队；原生落 expo-sqlite，Web 用内存"
    },
    {
      "id": "session",
      "type": "service",
      "label": "会话管理",
      "tech": "session.ts",
      "note": "内存 access + 持久 refresh，401 单飞刷新只重试一次"
    },
    {
      "id": "api_client",
      "type": "service",
      "label": "API 客户端",
      "tech": "api.ts 单例",
      "note": "原生 token 存 SecureStore，Web 存内存"
    },
    {
      "id": "mysql",
      "type": "database",
      "label": "MySQL 8",
      "tech": "MySQL 8.4 / SQLAlchemy 2 / Alembic",
      "note": "25 张表按 user/pet/health/task/media/chat/tracker/platform 分域；队列与配额的唯一事实源，运行时不支持 SQLite"
    },
    {
      "id": "redis",
      "type": "queue",
      "label": "Redis 7 + arq",
      "tech": "Redis 7-alpine",
      "note": "只承担调度信号，Redis 宕掉任务也不会丢，因为真源在 DB"
    },
    {
      "id": "s3",
      "type": "storage",
      "label": "S3 兼容对象存储",
      "tech": "MinIO / S3（必须开版本控制）",
      "note": "存媒体与 GIF 产物，桶未开版本控制时上传确认会全失败"
    },
    {
      "id": "rules",
      "type": "storage",
      "label": "版本化规则包",
      "tech": "rules/*.yaml（sx/rl/sc/at/ct/fd/am/motion）",
      "note": "规则 version 是契约，改规则必须升版本并同步 FRD 与 features"
    },
    {
      "id": "dashscope",
      "type": "external",
      "label": "DashScope 阿里云百炼",
      "tech": "qwen-max / qwen-plus / qwen-image-edit",
      "note": "文本建议、图像编辑、图生视频（wanx2.1-i2v-turbo）与语音合成（qwen2-audio）的唯一外部模型入口"
    },
    {
      "id": "smtp",
      "type": "external",
      "label": "SMTP 邮件服务",
      "tech": "SMTP",
      "note": "验证码与提醒邮件出口"
    },
    {
      "id": "ffprobe",
      "type": "external",
      "label": "ffprobe",
      "tech": "系统二进制",
      "note": "媒体校验依赖系统 ffprobe，缺失时上传校验会失败"
    }
  ],
