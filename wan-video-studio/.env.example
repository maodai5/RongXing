# 智谱开放平台 Key（https://open.bigmodel.cn）
ZHIPU_API_KEY=
ZHIPU_IMAGE_MODEL=glm-image
ZHIPU_IMAGE_SIZE=1280x1280

# 即梦 CLI：默认调用 PATH 里的 jimeng-novel，已登录即可
JIMENG_VIDEO_MODEL=Seedance_2.5
# JIMENG_CLI=jimeng-novel
# 复用已有画布，避免每次新建；留空则首次生成时自动创建一个
# JIMENG_PROJECT_ID=

# 仅在反向代理上线时填写：公网域名与访问密码（用户名固定为 studio）
# WAN_STUDIO_HOST=studio.example.com
# WAN_STUDIO_PASSWORD=
